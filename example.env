# WebSocket Configuration for Tank Cleaning Robot System
# Copy this file to .env and modify values as needed

# Tank-side WebSocket server configuration.
# On the ESP32/Pi network, set WEBSOCKET_HOST=0.0.0.0 on the tank side and
# TANK_WEBSOCKET_HOST=<tank-ip-or-hostname> on the master side.
WEBSOCKET_HOST=localhost
TANK_WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8765

# Optional: WebSocket connection settings
WEBSOCKET_TIMEOUT=10
WEBSOCKET_RECONNECT_DELAY=5
WEBSOCKET_MAX_RETRIES=3
